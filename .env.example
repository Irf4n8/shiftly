# Deployed Google Apps Script web app URL ending in /exec
APPS_SCRIPT_URL=https://script.google.com/macros/s/REPLACE_WITH_DEPLOYMENT_ID/exec

# Must exactly match the API_SECRET Script Property configured in Apps Script.
# Use a long random value, not a password you use elsewhere.
APPS_SCRIPT_SECRET=replace-with-a-long-random-secret

# Code required to open the website. Use a separate, strong value.
APP_ACCESS_CODE=choose-a-long-private-access-code
